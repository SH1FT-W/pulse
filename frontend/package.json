{
  "name": "@pulse/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pulse-Panel für Home Assistant – Lit + HAs eigene Elemente",
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  }
}
